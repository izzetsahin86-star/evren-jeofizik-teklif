{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "sync-data": false
    }
  },
  "functions": {
    "api/*.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/ced/?", "dest": "/ced.html" },
    { "src": "/ced.html", "dest": "/ced.html" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
